   <Row ss:Height="16.5">
    <Cell ss:StyleID="s62"><Data ss:Type="String">$loanApplication : LoanApplication(hasCollateralOfType(CollateralType.$param))</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">$loanApplication.calculateLoanToValueRatio().compareTo(new BigDecimal("$param")) < 0</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">$loanApplication.calculateLoanToValueRatio().compareTo(new BigDecimal("$param")) > 0</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">validationResults.add(new ValidationRuleResult("$param_LTV", </Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">"$param LTV Ratio", </Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">"$param", </Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">ValidationSeverity.$param, </Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">$param));</Data></Cell>
   </Row>
   <Row ss:Height="16.5">
    <Cell ss:StyleID="s62"><Data ss:Type="String">REAL_ESTATE</Data></Cell>
